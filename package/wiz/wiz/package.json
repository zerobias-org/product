{
  "name": "@zerobias-org/product-wiz-wiz",
  "version": "1.0.0-rc.1",
  "description": "Product package for Wiz",
  "author": "team@zerobias.com",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git@github.com:zerobias-org/product.git",
    "directory": "package/wiz/wiz/"
  },
  "scripts": {
    "correct:deps": "tsx ../../../scripts/correctDeps.ts",
