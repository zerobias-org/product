{
  "name": "@zerobias-org/product-sonatype-nexus",
  "version": "2.0.2",
  "description": "Sonatype Nexus Repository Manager provides a central platform for storing build artifacts, saving us significant maintenance and hardware costs.",
  "author": "team@zerobias.com",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git@github.com:zerobias-org/product.git",
    "directory": "package/sonatype/nexus/"
  },
  "scripts": {
    "correct:deps": "tsx ../../../scripts/correctDeps.ts"
  },
  "publishConfig": {
    "registry": "https://pkg.zerobias.org"
  },
  "files": [
    "catalog.yml",
    "components/**",
    "editions/**",
    "index.yml",
    "logo.*",
    "npm-shrinkwrap.json",
    "supports.yml"
  ],
  "dependencies": {
    "@zerobias-org/vendor-sonatype": "*"
  },
  "auditmation": {
    "dataloader-version": "5.0.25",
    "import-artifact": "product",
    "package": "sonatype.nexus"
  }
}
