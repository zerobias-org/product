{
  "name": "@zerobias-org/product-snyk-snyk",
  "version": "2.0.2",
  "description": "Snyk is a developer security platform that enables application and cloud developers to secure their whole application — finding and fixing vulnerabilities from their first lines of code to their running cloud.",
  "author": "team@zerobias.com",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git@github.com:zerobias-org/product.git",
    "directory": "package/snyk/snyk/"
  },
  "scripts": {
    "correct:deps": "tsx ../../../scripts/correctDeps.ts"
  },
  "publishConfig": {
    "registry": "https://pkg.zerobias.org"
  },
  "files": [
    "catalog.yml",
    "components/**",
    "editions/**",
    "index.yml",
    "logo.*",
    "npm-shrinkwrap.json",
    "supports.yml"
  ],
  "dependencies": {
    "@zerobias-org/vendor-snyk": "*"
  },
  "auditmation": {
    "dataloader-version": "5.0.25",
    "import-artifact": "product",
    "package": "snyk.snyk"
  }
}
