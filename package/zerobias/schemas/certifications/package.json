{
  "name": "@zerobias-org/product-zerobias-schemas-certifications",
  "version": "1.0.0",
  "description": "Product package for Compliance Certifications",
  "author": "team@zerobias.com",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git@github.com:zerobias-org/product.git",
    "directory": "package/zerobias/schemas/certifications/"
  },
  "scripts": {
    "correct:deps": "tsx ../../../../scripts/correctDeps.ts"
  },
