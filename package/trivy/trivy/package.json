{
  "name": "@zerobias-org/product-trivy-trivy",
  "version": "2.0.2",
  "description": "Trivy finds vulnerabilities (CVE) & misconfigurations (IaC) across code repositories, binary artifacts, container images, Kubernetes clusters, and more.",
  "author": "team@zerobias.com",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git@github.com:zerobias-org/product.git",
    "directory": "package/trivy/trivy/"
  },
  "scripts": {
    "correct:deps": "tsx ../../../scripts/correctDeps.ts"
  },
  "publishConfig": {
    "registry": "https://pkg.zerobias.org"
  },
  "files": [
    "catalog.yml",
    "components/**",
    "editions/**",
    "index.yml",
    "logo.*",
    "npm-shrinkwrap.json",
    "supports.yml"
  ],
  "dependencies": {
    "@zerobias-org/vendor-trivy": "*"
  },
  "auditmation": {
    "dataloader-version": "5.0.25",
    "import-artifact": "product",
    "package": "trivy.trivy"
  }
}
