{
  "name": "@zerobias-org/product-ocsf-ocsf",
  "version": "1.0.0",
  "description": "Product package for Open Cybersecurity Schema Framework",
  "author": "team@zerobias.com",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git@github.com:zerobias-org/product.git",
    "directory": "package/ocsf/ocsf/"
  },
  "scripts": {
    "correct:deps": "tsx ../../../scripts/correctDeps.ts"
  },
  "publishConfig": {
    "registry": "https://pkg.zerobias.org"
  },
  "files": [
    "catalog.yml",
    "components/**",
    "editions/**",
    "features/**",
    "index.yml",
    "logo.*",
    "supports.yml",
    "npm-shrinkwrap.json"
  ],
  "dependencies": {
    "@zerobias-org/vendor-ocsf": "*"
  },
  "zerobias": {
    "dataloader-version": "5.0.25",
    "import-artifact": "product",
    "package": "ocsf.ocsf"
  }
}
